# Copy to .env.local and fill in. Only public values belong here:
# never put backend secrets (DATABASE_URL, META_API_KEY, service keys) in Vite env.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional locally (Vite proxies /api). Set to the FastAPI origin for Vercel.
VITE_API_BASE_URL=
