# Copy to .env and fill in. Never commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/dbname

# Supabase access-token audience (default matches Supabase Auth):
# SUPABASE_JWT_AUDIENCE=authenticated

# Connection pool (optional, defaults shown):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# Existing RepoRescue settings:
META_API_KEY=your-meta-api-key
REPORESCUE_AI_MODE=stub
# REPORESCUE_ALLOW_UNSAFE_LOCAL_EXECUTION=1
