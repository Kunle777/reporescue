# Copy to .env and fill in. Never commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/dbname

# Exact browser origins allowed by FastAPI. Keep this list limited to the
# local Vite origins in development and the Vercel app origin in production.
REPORESCUE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase access-token audience (default matches Supabase Auth):
# SUPABASE_JWT_AUDIENCE=authenticated

# Connection pool (optional, defaults shown):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# Existing RepoRescue settings:
META_API_KEY=your-meta-api-key
REPORESCUE_AI_MODE=stub
# REPORESCUE_ALLOW_UNSAFE_LOCAL_EXECUTION=1
#
# Execution backend selection: auto (default), modal, docker, unsafe-local.
# auto prefers Modal when its credentials are configured, then Docker, and
# only uses unisolated host execution with the explicit flag above.
# REPORESCUE_EXECUTION_BACKEND=auto
#
# Cloud execution (Modal). Trusted worker environment only; never commit
# real values, never bake them into images, never pass them to repo code.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
#
# Modal sandbox resources and identity (defaults shown):
# REPORESCUE_MODAL_CPU=1
# REPORESCUE_MODAL_MEMORY_MB=1024
# REPORESCUE_MODAL_APP_NAME=reporescue-executions
# REPORESCUE_MODAL_NODE_IMAGE=node:22-slim
#
# Snapshot transfer caps (defaults shown):
# REPORESCUE_SNAPSHOT_MAX_TOTAL_BYTES=134217728
# REPORESCUE_SNAPSHOT_MAX_FILE_BYTES=10485760
# REPORESCUE_SNAPSHOT_MAX_FILES=20000
